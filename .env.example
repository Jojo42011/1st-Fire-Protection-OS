# ─────────────────────────────────────────────────────────────
# 1st FP Operating System — environment
# Every feature no-ops cleanly without its key. A keyless boot still runs
# on seeded sample data. Add keys to light up each capability.
# ─────────────────────────────────────────────────────────────

# Core server
PORT=3900
DB_PATH=./data/1stfp.db

# ── AI & Reasoning (the brain) ── add either one to enable live conversation/drafting
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small   # embeddings power hybrid memory recall

# ── The coder (the Harness's code-writing arm) ──
# Default: Claude (Opus 4.8) writes each new agent's real code module when ANTHROPIC_API_KEY is
# set (above). With no key at all, a real template module is emitted. Force one with CODER=.
CODER=                       # blank = auto (Opus 4.8 -> GPT -> Kimi) · anthropic | openai | kimi
# Optional: opt in to Kimi K3 (Moonshot) as the coder with MOONSHOT_API_KEY + CODER=kimi.
# NOTE (K3): the server fixes temperature/top_p/penalties (we omit them); reasoning stays on.
MOONSHOT_API_KEY=
MOONSHOT_MODEL=kimi-k3
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# "K3 Swarm" is a concurrency feature, not a distinct model id, so the swarm runs as parallel
# kimi-k3 passes (planner + N coders + reviewer/merge). Only used when CODER=kimi:
MOONSHOT_SWARM=hard          # off | hard (complex builds only, default) | all (every build)
MOONSHOT_SWARM_SIZE=3        # parallel coder passes (2-5)
MOONSHOT_SWARM_MODEL=        # optional: a real swarm model id if Moonshot ships one (else kimi-k3)

# ── Voice & Telephony (Call Receptionist goes live when present) ──
# Live path: forward 210-377-FIRE -> Twilio -> Vapi (BYO OpenAI key) -> transfer into Teams
VAPI_API_KEY=            # also enables /api/calls/sync backfill from Vapi's REST API
VAPI_SERVER_SECRET=      # shared secret; must match Vapi's Server URL secret (x-vapi-secret header)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Field service system of record (jobs, invoices, completions) ──
# Three ways to authenticate, in order of preference. Set ONE set.
# Reads work as soon as credentials exist; WRITES stay blocked until you flip the
# read-only/write toggle on the ServiceTrade Sync screen (default: read-only).
#   1) OAuth2 client credentials (recommended — machine-to-machine, rotatable):
SERVICETRADE_CLIENT_ID=
SERVICETRADE_CLIENT_SECRET=
#   2) A static API/access token (Bearer):
SERVICETRADE_TOKEN=
#   3) Username + password (PHPSESSID session auth):
SERVICETRADE_USERNAME=
SERVICETRADE_PASSWORD=
# Optional base-URL override (defaults to https://api.servicetrade.com/api)
SERVICETRADE_BASE_URL=
# Shared secret that guards the inbound webhook receiver (recommended once wired):
SERVICETRADE_WEBHOOK_SECRET=
# Public base URL used when auto-registering our webhook (defaults to the request host):
PUBLIC_BASE_URL=

# ── Accounting system of record — Sage Intacct (A/R for the Invoice Collector) ──
# Web-services sender credentials + a company login. All five required to connect.
# Reads work once set; WRITES stay blocked until you flip Intacct's read-only/write toggle.
INTACCT_SENDER_ID=
INTACCT_SENDER_PASSWORD=
INTACCT_COMPANY_ID=
INTACCT_USER_ID=
INTACCT_USER_PASSWORD=
# Optional gateway URL override (defaults to https://api.intacct.com/ia/xml/xmlgw.phtml)
INTACCT_URL=

# ── Comms & Ops ──
MS365_TOKEN=            # Microsoft 365 / Teams (call transfers, email)
N8N_API_KEY=           # workflow orchestration (call logging, review requests)

# ── Payments & Finance (Invoice Collector) ──
STRIPE_API_KEY=

# ── Reputation (Review Collector) ──
GOOGLE_BUSINESS_TOKEN=
FACEBOOK_PAGE_TOKEN=

# ── Messaging ──
GMAIL_ACCESS_TOKEN=

# ── License Reclaim (HR roster × software seats) ──
# BambooHR pulls the real active + terminated roster (the reconciliation source of truth).
BAMBOO_SUBDOMAIN=       # your BambooHR subdomain (the {sub} in {sub}.bamboohr.com)
BAMBOO_API_KEY=         # BambooHR API key (used as HTTP Basic username)
#
# Microsoft 365 seats via Microsoft Graph. Either a static bearer token, OR an Entra
# (Azure AD) app-registration client-credentials trio with Directory.Read.All.
MS_GRAPH_TOKEN=         # static Graph bearer token (optional shortcut)
MS_GRAPH_TENANT=        # Entra tenant id
MS_GRAPH_CLIENT_ID=     # app registration client id
MS_GRAPH_CLIENT_SECRET= # app registration client secret
MS_SKU_COST_JSON=       # optional {"ENTERPRISEPACK":36,...} monthly cost per SKU part number
#
# Adobe Creative Cloud seats via the User Management API (Server-to-Server credential).
ADOBE_UMAPI_TOKEN=
# Autodesk (AutoCAD) assigned users via the Autodesk account/APS API.
AUTODESK_TOKEN=
# Bluebeam / HydraCAD / HFSS have no public seat API — import those rosters via CSV in the app.
BLUEBEAM_API_KEY=
HYDRACAD_API_KEY=
HFSS_API_KEY=
