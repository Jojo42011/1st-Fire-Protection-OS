# ─────────────────────────────────────────────────────────────
# 1st FP Operating System — environment
# Every feature no-ops cleanly without its key. A keyless boot still runs
# on seeded sample data. Add keys to light up each capability.
# ─────────────────────────────────────────────────────────────

# Core server
PORT=3900
DB_PATH=./data/1stfp.db

# ── Systemize platform runtime ──
# The OS owns business/workflow state. These services are replaceable execution,
# reasoning and observability layers behind Systemize-owned contracts.
SYSTEMIZE_EVENT_TOKEN=        # shared server-side token for /api/platform/events
SYSTEMIZE_MCP_ENABLED=        # set to 1 when Systemize-owned MCP/tool adapters are exposed
COMPUTER_USE_ENABLED=         # set to 1 only for approved last-resort browser/computer execution

# Relevance AI — judgment-heavy agents/workforces. Copy the region-specific API
# trigger URL from the Relevance agent's API Trigger configuration.
RELEVANCE_API_URL=
RELEVANCE_API_KEY=

# Inngest — durable event-driven/scheduled workflow runtime. Systemize still
# keeps its own run/step/action/external-resource ledger in SQLite.
INNGEST_EVENT_KEY=
INNGEST_ENV=
INNGEST_EVENT_API_BASE_URL=https://inn.gs
INNGEST_SIGNING_KEY=

# OpenRouter — optional aggregation/routing behind Systemize ModelGateway.
# Keep direct provider keys below so this remains replaceable.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Langfuse — optional LLM/agent traces, evaluations and prompt datasets.
# Business workflow state never lives in Langfuse.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
AGENT_TRACE_CONSOLE=0

# ── AI & Reasoning (existing direct providers) ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# ── The coder (the Harness's code-writing arm) ──
CODER=                       # blank = auto · anthropic | openai | kimi
MOONSHOT_API_KEY=
MOONSHOT_MODEL=kimi-k3
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_SWARM=hard          # off | hard | all
MOONSHOT_SWARM_SIZE=3        # parallel coder passes (2-5)
MOONSHOT_SWARM_MODEL=

# ── Voice & Telephony ──
VAPI_API_KEY=
VAPI_SERVER_SECRET=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Field service system of record ──
SERVICETRADE_CLIENT_ID=
SERVICETRADE_CLIENT_SECRET=
SERVICETRADE_TOKEN=
SERVICETRADE_USERNAME=
SERVICETRADE_PASSWORD=
SERVICETRADE_BASE_URL=
SERVICETRADE_WEBHOOK_SECRET=
PUBLIC_BASE_URL=

# ── Accounting system of record — Sage Intacct ──
INTACCT_SENDER_ID=
INTACCT_SENDER_PASSWORD=
INTACCT_COMPANY_ID=
INTACCT_USER_ID=
INTACCT_USER_PASSWORD=
INTACCT_URL=

# ── Comms & Ops ──
MS365_TOKEN=

# n8n is prototype/client-specific glue, not the authoritative production
# workflow engine. Promote repeated/high-value flows into code-owned workflows.
N8N_API_KEY=

# ── Payments & Finance ──
STRIPE_API_KEY=

# ── Reputation / Meta ──
GOOGLE_BUSINESS_TOKEN=
FACEBOOK_PAGE_TOKEN=
META_ACCESS_TOKEN=

# ── Messaging ──
GMAIL_ACCESS_TOKEN=

# ── License Reclaim (HR roster × software seats) ──
BAMBOO_SUBDOMAIN=
BAMBOO_API_KEY=
MS_GRAPH_TOKEN=
MS_GRAPH_TENANT=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_SKU_COST_JSON=
ADOBE_UMAPI_TOKEN=
AUTODESK_TOKEN=
BLUEBEAM_API_KEY=
HYDRACAD_API_KEY=
HFSS_API_KEY=

# Demo safety kill-switch. ON by default. When on, external credentials are
# stripped at boot and the app runs keyless on a fresh seeded demo database.
DEMO_MODE=on
